      "question_text": "What is a race condition in concurrent programming?",
      "question_type": "multiple_choice",
      "points": 10,
      "options": [
        "When two threads compete in network speed",
        "When output depends on uncontrollable event timing/ordering",
        "When CPU clock rate accelerates",
        "A memory leak condition"
      ],
      "correct_answer": "When output depends on uncontrollable event timing/ordering",
      "explanation": "Race conditions occur when threads access shared memory concurrently without synchronization.",
      "order_index": 1,
